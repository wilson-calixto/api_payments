{
  "name": "api-payments",
  "version": "approved-payment-flow",
  "entrypoint": "POST /payments",
  "components": [
    {"id": "api_gateway", "type": "AWS::ApiGateway::RestApi", "responsibility": "Validates the payment payload and sends it to SQS"},
    {"id": "payments_queue", "type": "AWS::SQS::Queue", "responsibility": "Buffers payment requests"},
    {"id": "payments_dlq", "type": "AWS::SQS::Queue", "responsibility": "Stores requests that repeatedly fail"},
    {"id": "pipes", "type": "AWS::Pipes::Pipe", "responsibility": "Consumes one SQS message and starts Step Functions synchronously"},
    {"id": "state_machine", "type": "AWS::StepFunctions::StateMachine", "responsibility": "Coordinates validation, payment, persistence and publication"},
    {"id": "validate_order", "type": "AWS::Lambda::Function", "responsibility": "Validates valor and userId"},
    {"id": "process_payment", "type": "AWS::Lambda::Function", "responsibility": "Calls the payment provider and returns transaction_id"},
    {"id": "record_payment", "type": "AWS::Lambda::Function", "responsibility": "Atomically updates status and records PAYMENT_APPROVED"},
    {"id": "transactions_table", "type": "AWS::DynamoDB::Table", "key": "paymentId", "responsibility": "Current payment status and reconciliation status"},
    {"id": "events_table", "type": "AWS::DynamoDB::Table", "key": "eventId", "responsibility": "Immutable payment and audit events"},
    {"id": "success_topic", "type": "AWS::SNS::Topic", "responsibility": "PAYMENT_APPROVED integration bus"},
    {"id": "notification_lambda", "type": "AWS::Lambda::Function", "responsibility": "Loads the user and sends the payment email through SES"},
    {"id": "reconciliation_lambda", "type": "AWS::Lambda::Function", "responsibility": "Starts financial reconciliation and records its audit event"},
    {"id": "failure_lambda", "type": "AWS::Lambda::Function", "responsibility": "Classifies technical, financial, antifraud or business failures and persists context"},
    {"id": "failure_topic", "type": "AWS::SNS::Topic", "responsibility": "PAYMENT_FAILED notification bus"},
    {"id": "notification_redrive", "type": "AWS::Lambda::Function", "responsibility": "Operator-invoked replay from notification DLQ"},
    {"id": "users_table", "type": "AWS::DynamoDB::Table", "key": "userId", "responsibility": "User profile and verified email"},
    {"id": "notifications_table", "type": "AWS::DynamoDB::Table", "key": "notificationId", "responsibility": "Idempotency for email delivery"},
    {"id": "ses", "type": "AWS::SES", "responsibility": "Delivers payment notifications"},
    {"id": "dependent_systems", "type": "SNS subscribers", "responsibility": "Order, ERP and billing consumers subscribe to success_topic"}
  ],
  "flows": [
    {"from": "api_gateway", "to": "payments_queue", "event": "payment request"},
    {"from": "payments_queue", "to": "pipes", "event": "SQS message"},
    {"from": "pipes", "to": "state_machine", "event": "normalized input"},
    {"from": "state_machine", "to": "validate_order", "event": "validate"},
    {"from": "validate_order", "to": "process_payment", "event": "APPROVED only"},
    {"from": "process_payment", "to": "record_payment", "event": "PAID + transaction_id"},
    {"from": "record_payment", "to": "transactions_table", "event": "status=APPROVED"},
    {"from": "record_payment", "to": "events_table", "event": "PAYMENT_APPROVED"},
    {"from": "record_payment", "to": "success_topic", "event": "approved payment event"},
    {"from": "success_topic", "to": "notification_lambda", "event": "email notification"},
    {"from": "notification_lambda", "to": "users_table", "event": "lookup user"},
    {"from": "notification_lambda", "to": "notifications_table", "event": "deduplicate delivery"},
    {"from": "notification_lambda", "to": "ses", "event": "send email"},
    {"from": "success_topic", "to": "reconciliation_lambda", "event": "start reconciliation"},
    {"from": "reconciliation_lambda", "to": "transactions_table", "event": "reconciliationStatus=STARTED"},
    {"from": "reconciliation_lambda", "to": "events_table", "event": "RECONCILIATION_STARTED"},
    {"from": "success_topic", "to": "dependent_systems", "event": "fan-out to order, ERP and billing"}
    ,{"from": "process_payment", "to": "failure_lambda", "event": "retry exhausted / Catch"},
    {"from": "failure_lambda", "to": "transactions_table", "event": "status=FAILED + error context"},
    {"from": "failure_lambda", "to": "events_table", "event": "PAYMENT_FAILED audit event"},
    {"from": "failure_lambda", "to": "failure_topic", "event": "error code, category, retryable and source"},
    {"from": "failure_topic", "to": "dependent_systems", "event": "notify origin system"},
    {"from": "notification_redrive", "to": "failure_topic", "event": "manual replay from notification DLQ"}
  ]
}
